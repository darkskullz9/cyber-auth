{% extends 'base.html.twig' %}

{% block title %}Inscription - Cyber Auth{% endblock %}

{% block body %}
    <section class="auth-container" aria-labelledby="register-title">
        <header class="auth-header">
            <span class="auth-label">// CRÉATION DE COMPTE</span>
            <h1 id="register-title">Inscription</h1>
            <p>Créez votre compte pour accéder à la plateforme.</p>
        </header>

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm, {
            attr: {
                class: 'auth-form'
            }
        }) }}
            {{ form_row(registrationForm.email, {
                label: 'Email',
                row_attr: {class: 'form-group'}
            }) }}

            {{ form_row(registrationForm.nom, {
                label: 'Nom',
                row_attr: {class: 'form-group'}
            }) }}

            {{ form_row(registrationForm.prenom, {
                label: 'Prénom',
                row_attr: { class: 'form-group' }
            }) }}

            {{ form_row(registrationForm.adresse, {
                label: 'Adresse',
                row_attr: { class: 'form-group' }
            }) }}

            {{ form_row(registrationForm.ville, {
                label: 'Ville',
                row_attr: { class: 'form-group' }
            }) }}

            {{ form_row(registrationForm.codePostal, {
                label: 'Code postal',
                row_attr: { class: 'form-group' }
            }) }}

            {{ form_row(registrationForm.plainPassword, {
                label: 'Mot de passe',
                row_attr: { class: 'form-group' }
            }) }}

            {{ form_row(registrationForm.agreeTerms, {
                label: "J'accepte les conditions d'utilisation",
                row_attr: { class: 'remember-group' }
            }) }}

            <button type="submit" class="auth-submit">
                Créer mon compte
            </button>

            <p class="auth-register">
                Vous avez déjà un compte ?
                <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        {{ form_end(registrationForm) }}
    </section>
{% endblock %}
