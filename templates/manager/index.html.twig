{% extends 'base.html.twig' %}

{% block title %}Espace Manager - Cyber Auth{% endblock %}

{% block body %}
    <section class="manager-container" aria-labelledby="manager-title">
        <header class="manager-header">
            <h1 id="manager-title">Espace Manager</h1>
            <p>Consultation des utilisateurs et de leur historique de connexion.</p>
        </header>

        <h2>Liste des utilisateurs</h2>

        {% if users is empty %}
            <div class="manager-empty">
                <p>Aucun utilisateur enregistré.</p>
            </div>
        {% else %}
            <div class="manager-table-wrapper">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Email</th>
                            <th>Statut</th>
                            <th>Rôles</th>
                            <th>Historique des connexions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.nom }}</td>
                                <td>{{ user.prenom }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% if user.isSuspended %}
                                        <span class="manager-status manager-status-suspended">Suspendu</span>
                                    {% else %}
                                        <span class="manager-status manager-status-active">Actif</span>
                                    {% endif %}
                                </td>
                                <td>{{ user.roles|join(', ') }}</td>
                                <td>
                                    {% set histories = loginHistoriesByUserId[user.id] ?? [] %}

                                    {% if histories is empty %}
                                        <p class="manager-history-empty">Aucune connexion enregistrée.</p>
                                    {% else %}
                                        <ul class="manager-history-list">
                                            {% for history in histories %}
                                                <li class="manager-history-item">
                                                    <span class="manager-history-date">
                                                        {{ history.loggedAt|date('d/m/Y') }}
                                                    </span>
                                                    <span class="manager-history-time">
                                                        {{ history.loggedAt|date('H:i:s') }}
                                                    </span>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
