{% extends 'base.html.twig' %}

{% block title %}Mon profil - Cyber Auth{% endblock %}

{% block body %}
    <section class="surface-panel profile-container" aria-labelledby="profile-title">

        <header class="panel-header">
            <span class="section-kicker">// ESPACE PERSONNEL</span>
            <h1 id="profile-title">Mon profil</h1>
            <p>Consultez les informations associées à votre compte.</p>
        </header>

        <section class="profile-card" aria-labelledby="identity-title">

            <div class="profile-card-header">
                <h2 id="identity-title">Informations personnelles</h2>
                <span class="status-badge status-active">Compte actif</span>
            </div>

            <dl class="profile-details">

                <div class="profile-detail">
                    <dt>Prénom</dt>
                    <dd>{{ app.user.prenom }}</dd>
                </div>

                <div class="profile-detail">
                    <dt>Nom</dt>
                    <dd>{{ app.user.nom }}</dd>
                </div>

                <div class="profile-detail">
                    <dt>Email</dt>
                    <dd>{{ app.user.email }}</dd>
                </div>

                <div class="profile-detail">
                    <dt>Adresse</dt>
                    <dd>{{ app.user.adresse }}</dd>
                </div>

                <div class="profile-detail">
                    <dt>Ville</dt>
                    <dd>{{ app.user.ville }}</dd>
                </div>

                <div class="profile-detail">
                    <dt>Code postal</dt>
                    <dd>{{ app.user.codePostal }}</dd>
                </div>

            </dl>
        </section>

        <section class="profile-card" aria-labelledby="security-title">
            <div class="profile-card-header">
                <h2 id="security-title">Sécurité du compte</h2>
            </div>

            <p>Protégez votre compte en renouvelant régulièrement votre mot de passe.</p>

            <a href="{{ path('app_change_password') }}" class="btn">
                Modifier mon mot de passe
            </a>
        </section>

        <div class="profile-actions btn-group">
            <a href="{{ path('app_home') }}" class="btn">Retour à l'accueil</a>
            <a href="{{ path('app_logout') }}" class="btn btn-danger">
                Déconnexion
            </a>
        </div>

    </section>
{% endblock %}