{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe - Cyber Auth{% endblock %}

{% block body %}
    <section class="auth-container" aria-labelledby="password-title">

        <header class="auth-header">
            <span class="auth-label">// SÉCURITÉ DU COMPTE</span>
            <h1 id="password-title">Modifier mon mot de passe</h1>
            <p>Choisissez un nouveau mot de passe pour sécuriser votre compte.</p>
        </header>

        {% for message in app.flashes('success') %}
            <div class="auth-success" role="status">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(passwordForm, { attr: { class: 'auth-form' } }) }}

            <div class="form-group">
                {{ form_label(passwordForm.currentPassword, 'Mot de passe actuel') }}
                {{ form_widget(passwordForm.currentPassword) }}
                {{ form_errors(passwordForm.currentPassword) }}
            </div>

            <div class="form-group">
                {{ form_label(passwordForm.newPassword.first, 'Nouveau mot de passe') }}
                {{ form_widget(passwordForm.newPassword.first) }}
                {{ form_errors(passwordForm.newPassword.first) }}
            </div>

            <div class="form-group">
                {{ form_label(passwordForm.newPassword.second, 'Confirmer le nouveau mot de passe') }}
                {{ form_widget(passwordForm.newPassword.second) }}
                {{ form_errors(passwordForm.newPassword.second) }}
            </div>

            <button type="submit" class="auth-submit">
                Modifier mon mot de passe
            </button>

        {{ form_end(passwordForm) }}

        <p class="auth-register">
            <a href="{{ path('app_profile') }}">Retour à mon profil</a>
        </p>

    </section>
{% endblock %}