{% extends 'base.html.twig' %}

{% block title %}Administration - Cyber Auth{% endblock %}

{% block body %}
    <div class="container">
        <h1>Administration</h1>

        <h2>Gestion des utilisateurs</h2>

        <p>Nombre d'utilisateurs : {{ users|length }}</p>

        {% if users is empty %}
            <p>Aucun utilisateur enregistré.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Rôles</th>
                        <th>Statut</th>
                        <th>Historique des connexions</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.nom }}</td>
                            <td>{{ user.prenom }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.roles|join(', ') }}</td>
                            <td>{{ user.isSuspended ? 'Suspendu' : 'Actif' }}</td>
                            <td>
                                {% set histories = loginHistoriesByUserId[user.id] ?? [] %}

                                {% if histories is empty %}
                                    <span>Aucune connexion enregistrée</span>
                                {% else %}
                                    <ul>
                                        {% for history in histories %}
                                            <li>
                                                {{ history.loggedAt|date('d/m/Y à H:i:s') }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>

                            <td>
                                <a href="{{ path('app_admin_user_edit', {id: user.id}) }}">
                                    Modifier
                                </a>

                                <a href="{{ path('app_admin_user_roles', {id: user.id}) }}">
                                    Gérer les rôles
                                </a>

                                <form
                                    method="post"
                                    action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                                    onsubmit="return confirm('Voulez-vous vraiment supprimer cet utilisateur et son historique de connexion ?');"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('delete-user-' ~ user.id) }}"
                                    >

                                    <button type="submit">
                                        Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
