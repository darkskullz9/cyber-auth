{% extends 'base.html.twig' %}

{% block title %}Modifier un utilisateur - Cyber Auth{% endblock %}

{% block body %}
    <section class="surface-panel form-panel" aria-labelledBy="edit-user-title">
        <header class="panel-header">
            <span class="section-kicker">// GESTION DES UTILISATEURS</span>
            <h1 id="edit-user-title">Modifier un utilisateur</h1>
            <p>
                Modification du compte :
                <strong>{{ user.email }}</strong>
            </p>
        </header>

            {{ form_start(userForm, { attr: { class: 'cyber-form' } }) }}
                {{ form_row(userForm.email, {row_attr: { class: 'form-group' } }) }}
                {{ form_row(userForm.nom, {row_attr: { class: 'form-group' } }) }}
                {{ form_row(userForm.prenom, {row_attr: { class: 'form-group' } }) }}
                {{ form_row(userForm.adresse, {row_attr: { class: 'form-group' } }) }}
                {{ form_row(userForm.ville, {row_attr: { class: 'form-group' } }) }}

                {{ form_row(userForm.codePostal, {
                    label: 'Code postal', 
                    row_attr: { class: 'form-group' } 
                }) }}
                
                {{ form_row(userForm.isSuspended, {
                    label: 'Compte suspendu', 
                    row_attr: { class: 'form-group' } 
                }) }}

                <button type="submit" class="btn btn-primary">
                    Enregistrer les modifications
                </button>

            {{ form_end(userForm) }}

        <p class="form-footer">
            <a href="{{ path('app_admin') }}"> Retour à l'administration</a>
        </p>
    </section>
{% endblock %}