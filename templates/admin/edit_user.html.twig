{% extends 'base.html.twig' %}

{% block title %}Modifier un utilisateur - Cyber Auth{% endblock %}

{% block body %}
    <div class="container">
        <h1>Modifier un utilisateur</h1>

        <p>
            Modification du compte :
            <strong>{{ user.email }}</strong>
        </p>

        {{ form_start(userForm) }}

            {{ form_row(userForm.email) }}
            {{ form_row(userForm.nom) }}
            {{ form_row(userForm.prenom) }}
            {{ form_row(userForm.adresse) }}
            {{ form_row(userForm.ville) }}
            {{ form_row(userForm.codePostal) }}
            {{ form_row(userForm.isSuspended) }}

            <button type="submit">
                Enregistrer les modifications
            </button>

        {{ form_end(userForm) }}

        <a href="{{ path('app_admin') }}">
            Retour à l'administration
        </a>
    </div>
{% endblock %}